#!/usr/bin/env php
<?php

// Usage: bin/scheduler [path/to/schedules.json]   (run it from cron every minute)

require __DIR__ . '/../vendor/autoload.php';

use IProDev\Sitemap\Scheduler\CronScheduler;
use IProDev\Sitemap\Utils;

$scheduleFile = $argv[1] ?? './schedules.json';
$phpBinary = PHP_BINARY !== '' ? PHP_BINARY : 'php';

try {
    $scheduler = new CronScheduler($scheduleFile);
} catch (\Throwable $e) {
    fwrite(STDERR, "❌ {$e->getMessage()}\n");
    exit(1);
}

// Only one scheduler at a time: cron starts us every minute, but crawls can take longer
if (!$scheduler->lock()) {
    echo "Another scheduler run is still in progress; skipping.\n";
    exit(0);
}

// Get schedules that should run now
$dueSchedules = $scheduler->getDueSchedules();

if (empty($dueSchedules)) {
    echo "No schedules due to run.\n";
    exit(0);
}

echo "Found " . count($dueSchedules) . " schedule(s) to run:\n";

foreach ($dueSchedules as $schedule) {
    $name = (string)$schedule['name'];
    $config = $schedule['config'] ?? null;

    echo "\nRunning: {$name}\n";
    echo str_repeat('-', 50) . "\n";

    try {
        if (!is_array($config)) {
            throw new \RuntimeException('Schedule config must be an object');
        }

        // Move next_run forward *before* running, so a slow or failing crawl is not
        // started again on the next scheduler run
        try {
            $scheduler->markAsRun($name);
        } catch (\InvalidArgumentException $e) {
            $scheduler->toggleSchedule($name, false);
            throw new \RuntimeException($e->getMessage() . '; schedule disabled', 0, $e);
        }

        // Build the command as an argument array: proc_open() then runs it
        // without a shell, so config values can never inject shell commands.
        $skipped = [];
        $command = array_merge(
            [$phpBinary, __DIR__ . '/sitemap'],
            CronScheduler::buildArguments($config, $skipped)
        );

        if (!empty($skipped)) {
            echo "Ignoring unknown or invalid options: " . implode(', ', $skipped) . "\n";
        }

        // Display a redacted version so credentials do not end up in logs
        $display = array_merge(
            [$phpBinary, __DIR__ . '/sitemap'],
            CronScheduler::buildArguments(Utils::redactConfig($config))
        );
        echo "Command: " . implode(' ', array_map('escapeshellarg', $display)) . "\n\n";

        // Execute, streaming the child's output straight to ours
        $process = proc_open($command, [0 => ['pipe', 'r'], 1 => STDOUT, 2 => STDERR], $pipes);
        if (!is_resource($process)) {
            throw new \RuntimeException('Failed to start bin/sitemap');
        }
        fclose($pipes[0]);
        $returnCode = proc_close($process);
        $scheduler->recordResult($name, $returnCode);

        if ($returnCode === 0) {
            echo "\n✅ Schedule '{$name}' completed successfully\n";
        } else {
            echo "\n❌ Schedule '{$name}' failed with code {$returnCode}\n";
        }
    } catch (\Throwable $e) {
        echo "❌ Error running schedule '{$name}': {$e->getMessage()}\n";
    }

    echo str_repeat('-', 50) . "\n";
}

$scheduler->unlock();
echo "\nScheduler completed.\n";

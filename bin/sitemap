use IProDev\Sitemap\Sitemap\NewsSitemapWriter;
use Psr\Http\Message\ResponseInterface;

const EXIT_INTERRUPTED = 130;

/**
 * Options that take a value (--name=value or --name value)
 */
const VALUE_OPTIONS = [
    'url', 'out', 'concurrency', 'max-pages', 'max-depth', 'public-base',
    'rate-limit', 'delay', 'checkpoint-interval', 'checkpoint-file', 'max-response-size',
    'db-dsn', 'db-user', 'exclude', 'include', 'priority-rules', 'report-dir', 'news-publication',
    'proxy', 'proxy-file', 'webhook-url',
    // No effect, accepted for compatibility
    'cache-driver', 'cache-ttl', 'chrome-path', 'wait-for-ajax',
];

/**
 * On/off options
 */
const FLAG_OPTIONS = [
    'resume', 'block-private-ips', 'db-enabled', 'detect-changes', 'only-changed',
    'seo-analysis', 'check-quality', 'find-duplicates', 'find-broken-links',
    'image-sitemap', 'video-sitemap', 'news-sitemap', 'rotate-proxies',
    'notify-on-complete', 'notify-on-error', 'interactive', 'verbose', 'help', 'version',
    // No effect, accepted for compatibility
    'cache-enabled', 'enable-javascript',
];

/**
 * Simple console logger (warnings and errors go to STDERR)
 */
class ConsoleLogger extends \Psr\Log\AbstractLogger {
    private bool $verbose;
    private float $startTime;

    public function __construct(bool $verbose = false) {
        $this->verbose = $verbose;
        $this->startTime = microtime(true);
    }

    public function log($level, $message, array $context = []): void {
        $timestamp = sprintf('[%.2fs]', microtime(true) - $this->startTime);

        if (!$this->verbose && $level === 'debug') {
            return;
        }

        $levelColors = [
            'emergency' => "\033[1;31m",
            'alert'     => "\033[1;31m",
            'critical'  => "\033[1;31m",
            'error'     => "\033[0;31m",
            'warning'   => "\033[0;33m",
            'notice'    => "\033[0;36m",
            'info'      => "\033[0;32m",
            'debug'     => "\033[0;37m",
        ];

        $reset = "\033[0m";
        $color = $levelColors[$level] ?? '';

        $contextStr = !empty($context) ? ' ' . json_encode($context, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) : '';
        $line = "{$timestamp} {$color}[{$level}]{$reset} {$message}{$contextStr}" . PHP_EOL;

        if (in_array($level, ['warning', 'error', 'critical', 'alert', 'emergency'], true)) {
            fwrite(STDERR, $line);
        } else {
            echo $line;
        }
    }
}

/**
 * Display help message
 */
function showHelp(): void {
    echo <<<HELP
PHP XML Sitemap Generator - Professional CLI Tool

Usage:
  sitemap --url=<URL> [OPTIONS]

Required Options:
  --url=<URL>                Starting URL to crawl

Basic Options:
  --out=<PATH>               Output directory (default: ./output)
  --concurrency=<N>          Concurrent requests (default: 10, max: 100)
  --max-pages=<N>            Maximum pages in the sitemap (default: 50000)
  --max-depth=<N>            Maximum link depth (default: 5)
  --public-base=<URL>        Public base URL for sitemap index (default: origin of --url)

Crawling:
  --rate-limit=<N>           Maximum requests per minute
  --delay=<MS>               Wait between requests in milliseconds (requests are sent one at a time)
  --resume                   Continue an interrupted crawl from its checkpoint
  --checkpoint-interval=<N>  Save progress every N requests (default: 1000, 0 = off)
  --checkpoint-file=<PATH>   Checkpoint file (default: ./checkpoint.json)
  --max-response-size=<MB>   Skip responses larger than this (default: 10, 0 = no limit)
  --block-private-ips        Refuse requests and redirects to private/internal addresses

Database & Change Detection:
  --db-enabled               Store crawl results in a database
  --db-dsn=<DSN>             PDO DSN: sqlite, mysql or pgsql (default: sqlite:./sitemap.db)
  --db-user=<USER>           Database user (default: \$DB_USERNAME); the password is read from \$DB_PASSWORD
  --detect-changes           Compare with the previous crawl of the same domain
  --only-changed             Only write new and modified URLs to the sitemap (implies --detect-changes)

Filtering:
  --exclude=<PATTERNS>       Do not crawl or list URLs matching these patterns (comma-separated, * and ?)
  --include=<PATTERNS>       Only list URLs matching these patterns (other pages are still crawled)
  --priority-rules=<JSON>    Priorities, e.g. '{"/blog/*":0.8,"/products/*":0.9}'

Reports (written as JSON to --report-dir):
  --report-dir=<PATH>        Report directory (default: ./reports)
  --seo-analysis             SEO checks for every page (seo-report.json)
  --check-quality            Content quality report (quality-report.json)
  --find-duplicates          Pages with identical content (duplicates.json)
  --find-broken-links        Links that returned errors, with the linking page (broken-links.json)

Additional Sitemaps (listed in the sitemap index):
  --image-sitemap            Image sitemap
  --video-sitemap            Video sitemap (YouTube/Vimeo embeds and <video> elements)
  --news-sitemap             News sitemap (articles published in the last 2 days)
  --news-publication=<NAME>  Publication name for the news sitemap (default: og:site_name or host)

Proxy:
  --proxy=<URL>              Proxy URL, e.g. http://user:pass@proxy:8080
  --proxy-file=<PATH>        Load proxies from file (one per line: url or url|user:pass)
  --rotate-proxies           Use the next proxy for every request

Notifications:
  --webhook-url=<URL>        Webhook for notifications
  --notify-on-complete       Notify when complete
  --notify-on-error          Notify on errors

Other:
  --interactive, -i          Interactive configuration mode
  --verbose, -v              Enable verbose output
  --help, -h                 Show this help message
  --version                  Show the version

Not functional yet (accepted, but have no effect):
  --enable-javascript, --chrome-path, --wait-for-ajax
  --cache-enabled, --cache-driver, --cache-ttl

Examples:
  # Basic usage
  sitemap --url=https://www.example.com

  # Polite crawl with change detection
  sitemap --url=https://example.com --rate-limit=120 --db-enabled --detect-changes

  # Resume interrupted crawl (Ctrl+C saves progress)
  sitemap --url=https://example.com --resume

  # With filtering and priorities
  sitemap --url=https://example.com --exclude="/admin/*,/test/*" --priority-rules='{"/blog/*":0.8}'

  # Interactive mode
  sitemap --interactive

HELP;
}


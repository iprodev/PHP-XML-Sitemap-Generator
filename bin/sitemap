        'blockPrivateIps' => false,

        'dbEnabled' => false,
        'dbDsn' => 'sqlite:./sitemap.db',
        'dbUser' => null,
        'detectChanges' => false,
        'onlyChanged' => false,

        'exclude' => [],
        'include' => [],
        'priorityRules' => [],

        'reportDir' => './reports',
        'seoAnalysis' => false,
        'checkQuality' => false,
        'findDuplicates' => false,
        'findBrokenLinks' => false,

        'imageSitemap' => false,
        'videoSitemap' => false,
        'newsSitemap' => false,
        'newsPublication' => null,

        'proxy' => null,
        'proxyFile' => null,
        'rotateProxies' => false,

        'webhookUrl' => null,
        'notifyOnComplete' => false,
        'notifyOnError' => false,

        'enableJavaScript' => false,
        'cacheEnabled' => false,
    ];
}

/**
 * Reject options this tool does not know (getopt() silently ignores them)
 */
function checkUnknownOptions(array $argv): void {
    foreach (array_slice($argv, 1) as $arg) {
        if (!str_starts_with($arg, '--')) {
            continue;
        }
        $name = explode('=', substr($arg, 2), 2)[0];
        if ($name !== '' && !in_array($name, VALUE_OPTIONS, true) && !in_array($name, FLAG_OPTIONS, true)) {
            throw new \InvalidArgumentException("Unknown option --{$name} (see --help)");
        }
    }
}

/**
 * Read a numeric option
 */
function numberOption(array $options, string $name, $default, float $min) {
    if (!isset($options[$name])) {
        return $default;
    }

    $value = is_array($options[$name]) ? end($options[$name]) : $options[$name];
    if (!is_numeric($value) || (float)$value < $min) {
        throw new \InvalidArgumentException("--{$name} must be a number >= {$min}");
    }

    return is_int($default) || $default === null ? (int)$value : (float)$value;
}

function stringOption(array $options, string $name): ?string {
    if (!isset($options[$name])) {
        return null;
    }

    $value = is_array($options[$name]) ? end($options[$name]) : $options[$name];
    return $value === false || $value === '' ? null : (string)$value;
}

function listOption(array $options, string $name): array {
    $value = stringOption($options, $name);
    return $value === null ? [] : array_values(array_filter(array_map('trim', explode(',', $value)), 'strlen'));
}

/**
 * Parse command line arguments
 */
function parseArguments(): array {
    global $argv;

    $longOpts = array_merge(array_map(fn($name) => $name . ':', VALUE_OPTIONS), FLAG_OPTIONS);
    $options = getopt('hvi', $longOpts);

    if (isset($options['h']) || isset($options['help'])) {
        showHelp();
        exit(0);
    }

    if (isset($options['version'])) {
        echo 'PHP XML Sitemap Generator ' . Version::NUMBER . PHP_EOL;
        exit(0);
    }

    checkUnknownOptions($argv);

    // Interactive mode
    if (isset($options['i']) || isset($options['interactive'])) {
        $interactive = new InteractiveMode();
        $config = array_merge(defaultConfig(), $interactive->run());
        validateConfig($config);
        return $config;
    }

    if (stringOption($options, 'url') === null) {
        fwrite(STDERR, "Error: --url is required\n\n");
        showHelp();
        exit(1);
    }

    $priorityRules = [];
    if (($rules = stringOption($options, 'priority-rules')) !== null) {
        $priorityRules = json_decode($rules, true);
        if (!is_array($priorityRules)) {
            throw new \InvalidArgumentException('--priority-rules must be a JSON object, e.g. {"/blog/*":0.8}');
        }
    }

    $config = array_merge(defaultConfig(), [
        'url' => stringOption($options, 'url'),
        'out' => stringOption($options, 'out') ?? './output',
        'concurrency' => numberOption($options, 'concurrency', 10, 1),
        'maxPages' => numberOption($options, 'max-pages', 50000, 1),
        'maxDepth' => numberOption($options, 'max-depth', 5, 0),
        'publicBase' => stringOption($options, 'public-base'),
        'verbose' => isset($options['v']) || isset($options['verbose']),

        'rateLimit' => numberOption($options, 'rate-limit', null, 1),
        'delay' => numberOption($options, 'delay', 0, 0),
        'resume' => isset($options['resume']),
        'checkpointInterval' => numberOption($options, 'checkpoint-interval', 1000, 0),
        'checkpointFile' => stringOption($options, 'checkpoint-file') ?? './checkpoint.json',
        'maxResponseSize' => numberOption($options, 'max-response-size', 10.0, 0),
        'blockPrivateIps' => isset($options['block-private-ips']),

        'dbEnabled' => isset($options['db-enabled']),
        'dbDsn' => stringOption($options, 'db-dsn') ?? 'sqlite:./sitemap.db',
        'dbUser' => stringOption($options, 'db-user'),
        'detectChanges' => isset($options['detect-changes']) || isset($options['only-changed']),
        'onlyChanged' => isset($options['only-changed']),

        'exclude' => listOption($options, 'exclude'),
        'include' => listOption($options, 'include'),
        'priorityRules' => $priorityRules,

        'reportDir' => stringOption($options, 'report-dir') ?? './reports',
        'seoAnalysis' => isset($options['seo-analysis']),
        'checkQuality' => isset($options['check-quality']),
        'findDuplicates' => isset($options['find-duplicates']),
        'findBrokenLinks' => isset($options['find-broken-links']),

        'imageSitemap' => isset($options['image-sitemap']),
        'videoSitemap' => isset($options['video-sitemap']),
        'newsSitemap' => isset($options['news-sitemap']),
        'newsPublication' => stringOption($options, 'news-publication'),

        'proxy' => stringOption($options, 'proxy'),
        'proxyFile' => stringOption($options, 'proxy-file'),
        'rotateProxies' => isset($options['rotate-proxies']),

        'webhookUrl' => stringOption($options, 'webhook-url'),
        'notifyOnComplete' => isset($options['notify-on-complete']),
        'notifyOnError' => isset($options['notify-on-error']),

        'enableJavaScript' => isset($options['enable-javascript'])
            || isset($options['chrome-path']) || isset($options['wait-for-ajax']),
        'cacheEnabled' => isset($options['cache-enabled'])
            || isset($options['cache-driver']) || isset($options['cache-ttl']),
    ]);

    validateConfig($config);

    return $config;
}

/**
 * Validate a complete configuration
 */
function validateConfig(array $config): void {
    if (!is_string($config['url']) || !Utils::isValidUrl($config['url'])) {
        throw new \InvalidArgumentException('--url must be an http:// or https:// URL');
    }
    if ($config['concurrency'] < 1 || $config['concurrency'] > 100) {
        throw new \InvalidArgumentException('--concurrency must be between 1 and 100');
    }
    if ($config['onlyChanged'] && !$config['dbEnabled']) {
        throw new \InvalidArgumentException('--only-changed needs --db-enabled to compare with the previous crawl');
    }
    foreach ($config['priorityRules'] as $pattern => $priority) {
        if (!is_string($pattern) || !is_numeric($priority) || $priority < 0 || $priority > 1) {
            throw new \InvalidArgumentException('--priority-rules values must be numbers between 0 and 1');
        }
    }
}

/**
 * Warn about options that are accepted but do nothing
 */
function warnUnsupported(array $config, ConsoleLogger $logger): void {
    if ($config['cacheEnabled']) {
        $logger->warning('--cache-enabled, --cache-driver and --cache-ttl have no effect and will be removed');
    }
    if ($config['enableJavaScript']) {
        $logger->warning('JavaScript rendering is not functional yet; pages are fetched without running JavaScript');
    }
}

/**
 * Display configuration summary
 */
function showConfig(array $config): void {
    echo "\n" . str_repeat('=', 70) . "\n";
    echo "  PHP XML Sitemap Generator " . Version::NUMBER . "\n";
    echo str_repeat('=', 70) . "\n";
    echo "Configuration:\n";
    echo "  URL:         " . Utils::redactUrl($config['url']) . "\n";
    echo "  Output:      {$config['out']}\n";
    echo "  Concurrency: {$config['concurrency']}\n";
    echo "  Max Pages:   {$config['maxPages']}\n";
    echo "  Max Depth:   {$config['maxDepth']}\n";

    if ($config['rateLimit'] || $config['delay']) {
        $limit = $config['rateLimit'] ? "{$config['rateLimit']}/min" : 'unlimited';
        echo "  Rate limit:  {$limit}, delay {$config['delay']} ms\n";
    }
    if (!empty($config['exclude']) || !empty($config['include'])) {
        echo "  Filters:     exclude " . (implode(', ', $config['exclude']) ?: '-')
            . "; include " . (implode(', ', $config['include']) ?: '-') . "\n";
    }
    if ($config['dbEnabled']) {
        echo "  Database:    " . Utils::redactConfig(['dsn' => $config['dbDsn']])['dsn'] . "\n";
    }
    if ($config['proxy']) {
        echo "  Proxy:       " . Utils::redactUrl($config['proxy']) . "\n";
    }

    echo str_repeat('=', 70) . "\n\n";
}

/**
 * Add the page processors needed by the requested reports and sitemaps
 */
function addPageProcessors(Crawler $crawler, array $config, string $domain): void {
    if ($config['seoAnalysis']) {
        $analyzer = new SeoAnalyzer();
        $crawler->addPageProcessor(function (array $page, string $html, ResponseInterface $response) use ($analyzer) {
            if ($html === '') {
                return null;
            }

            $headers = $response->getHeaders();
            // Guzzle decodes compressed bodies and moves Content-Encoding to this header
            if ($response->hasHeader('X-Encoded-Content-Encoding')) {
                $headers['Content-Encoding'] = $response->getHeader('X-Encoded-Content-Encoding');
            }

            $result = $analyzer->analyze($page['url'], $html, $page['status'], $headers);

            return ['seo' => [
                'score' => $result['score'],
                'issues' => array_column($result['issues'], 'message'),
                'warnings' => array_column($result['warnings'], 'message'),
                'recommendations' => array_column($result['recommendations'], 'message'),
            ]];
        });
    }

    if ($config['imageSitemap']) {
        $crawler->addPageProcessor(function (array $page, string $html) {
            $images = $html === '' ? [] : ImageSitemapWriter::extractImages($html, $page['url']);
            return empty($images) ? null : ['images' => $images];
        });
    }

    if ($config['videoSitemap']) {
        $crawler->addPageProcessor(function (array $page, string $html) {
            $videos = $html === '' ? [] : VideoSitemapWriter::extractVideos($html, $page['url']);
            return empty($videos) ? null : ['videos' => $videos];
        });
    }

    if ($config['newsSitemap']) {
        $crawler->addPageProcessor(function (array $page, string $html) use ($config, $domain) {
            if ($html === '') {
                return null;
            }

            $meta = NewsSitemapWriter::extractNewsMetadata($html);
            if (empty($meta['publication_date'])) {
                return null;
            }

            return ['news' => [
                'publication_date' => $meta['publication_date'],
                'title' => $meta['title'] ?? $page['title'],
                'keywords' => $meta['keywords'] ?? null,
                'publication_name' => $config['newsPublication'] ?? ($meta['publication_name'] ?? $domain),
                'language' => $page['lang'] ?? null,
            ]];
        });
    }
}

/**
 * Ctrl+C / SIGTERM: stop after the current batch and save a checkpoint
 */
function installSignalHandlers(Crawler $crawler, ConsoleLogger $logger): void {
    if (!function_exists('pcntl_async_signals') || !function_exists('pcntl_signal')) {
        return;
    }

    pcntl_async_signals(true);
    $stopping = false;

    $handler = function () use ($crawler, $logger, &$stopping) {
        if ($stopping) {
            fwrite(STDERR, PHP_EOL . "Aborted." . PHP_EOL);
            exit(EXIT_INTERRUPTED);
        }
        $stopping = true;
        $logger->warning('Stopping after the current batch (press Ctrl+C again to quit immediately)...');
        $crawler->requestStop();
    };

    pcntl_signal(SIGINT, $handler);
    pcntl_signal(SIGTERM, $handler);
}

/**
 * Write the requested JSON reports and print short summaries
 *
 * @return string[] report files
 */
function writeReports(array $config, array $pages, array $errors, ConsoleLogger $logger): array {
    $files = [];
    $write = function (string $name, array $data) use ($config, &$files): string {
        $dir = $config['reportDir'];
        if (!is_dir($dir) && !mkdir($dir, 0755, true) && !is_dir($dir)) {
            throw new \RuntimeException("Failed to create report directory: {$dir}");
        }
        $path = rtrim($dir, '/\\') . DIRECTORY_SEPARATOR . $name;
        $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
        if ($json === false || file_put_contents($path, $json) === false) {
            throw new \RuntimeException("Failed to write report: {$path}");
        }
        $files[] = $path;
        return $path;
    };

    $checker = new ContentQualityChecker();

    if ($config['findBrokenLinks']) {
        $path = $write('broken-links.json', ['count' => count($errors), 'links' => $errors]);
        $logger->info('Broken links: ' . count($errors), ['report' => $path]);
        foreach (array_slice($errors, 0, 10) as $error) {
            $from = $error['referrer'] ? " (linked from {$error['referrer']})" : '';
            echo "    {$error['error']}: {$error['url']}{$from}\n";
        }
    }

    if ($config['findDuplicates']) {
        $duplicates = $checker->findDuplicates($pages);
        $path = $write('duplicates.json', ['count' => count($duplicates), 'duplicates' => $duplicates]);
        $logger->info('Duplicate content: ' . count($duplicates), ['report' => $path]);
    }

    if ($config['checkQuality']) {
        $report = $checker->generateReport($pages);
        // Pages with errors are not in $pages; report the crawl errors instead
        $report['broken_links'] = ['count' => count($errors), 'details' => $errors];
        $path = $write('quality-report.json', $report);
        $logger->info('Content quality score: ' . $report['quality_score'] . '/100', ['report' => $path]);
    }

    if ($config['seoAnalysis']) {
        $results = [];
        foreach ($pages as $page) {
            if (isset($page['seo'])) {
                $results[] = ['url' => $page['url']] + $page['seo'];
            }
        }
        usort($results, fn($a, $b) => $a['score'] <=> $b['score']);
        $average = empty($results) ? 0 : round(array_sum(array_column($results, 'score')) / count($results), 1);

        $path = $write('seo-report.json', ['average_score' => $average, 'pages' => $results]);
        $logger->info("Average SEO score: {$average}/100", ['pages' => count($results), 'report' => $path]);
    }

    return $files;
}

// Main execution
$config = [];
$webhooks = null;

try {
    $config = parseArguments();
    $logger = new ConsoleLogger($config['verbose']);

    warnUnsupported($config, $logger);
    showConfig($config);

    $startTime = microtime(true);
    $domain = (string)Utils::getDomain($config['url']);

    $logger->info("Initializing crawler...");

    // Setup proxy
    $proxyManager = null;
    if ($config['proxy'] || $config['proxyFile']) {
        $proxyManager = $config['proxyFile']
            ? ProxyManager::loadFromFile($config['proxyFile'], $config['rotateProxies'])
            : new ProxyManager([], $config['rotateProxies']);
        if ($config['proxy']) {
            $proxyManager->addProxy($config['proxy']);
        }
        $logger->info("Proxy configured", ['count' => $proxyManager->count()]);
    }

    // Setup webhooks
    if ($config['webhookUrl']) {
        $webhooks = new WebhookNotifier([], $logger);
        $webhooks->addWebhook($config['webhookUrl']);
        $logger->info("Webhooks configured");
    }

    // Initialize fetcher; the proxy has to be part of the options before it is created
    $fetcherOptions = [
        'concurrency' => $config['concurrency'],
        'timeout' => 15,
        'max_response_size' => (int)round($config['maxResponseSize'] * 1024 * 1024),
        'block_private_ips' => $config['blockPrivateIps'],
    ];
    if ($proxyManager && $proxyManager->count() > 0) {
        if ($proxyManager->isRotating() && $proxyManager->count() > 1) {
            $fetcherOptions['proxies'] = $proxyManager->getProxyUrls();
        } else {
            $fetcherOptions = array_merge($fetcherOptions, $proxyManager->getGuzzleProxyConfig() ?? []);
        }
    }
    $fetcher = new Fetcher($fetcherOptions, $logger);

    // Setup database (before crawling, so a bad DSN fails fast)
    $db = null;
    $crawlId = null;
    if ($config['dbEnabled']) {
        $db = new Database(
            $config['dbDsn'],
            $config['dbUser'] ?? (getenv('DB_USERNAME') ?: null),
            getenv('DB_PASSWORD') ?: null
        );
        $db->createTables();
        $crawlId = $db->startCrawl($domain, $config['url'], $config);
        $logger->info("Database initialized", ['driver' => $db->getDriver(), 'crawl_id' => $crawlId]);
    }

    // Load robots.txt
    $logger->info("Fetching robots.txt...");
    $robots = RobotsTxt::fromUrl($config['url'], $fetcher);
    $logger->info("Robots.txt loaded", [
        'disallows' => count($robots->getDisallows()),
        'allows' => count($robots->getAllows())
    ]);

    // Setup URL filter: excluded URLs are never fetched; include patterns and priorities apply to the sitemap
    $filter = new UrlFilter([
        'exclude' => $config['exclude'],
        'include' => $config['include'],
        'priority' => $config['priorityRules']
    ]);

    $crawler = new Crawler($fetcher, $robots, $logger);
    $crawler->setUrlFilter($filter);

    if ($config['rateLimit'] || $config['delay'] > 0) {
        $crawler->setRateLimiter(new RateLimiter($config['rateLimit'] ?: PHP_INT_MAX, 60, $config['delay']));
        $logger->info("Rate limiting enabled", ['per_minute' => $config['rateLimit'], 'delay_ms' => $config['delay']]);
    }

    $checkpoint = null;
    if ($config['checkpointInterval'] > 0 || $config['resume']) {
        $checkpoint = new CrawlCheckpoint($config['checkpointFile'], max(1, $config['checkpointInterval']));
        if ($config['resume']) {
            $info = $checkpoint->getInfo();
            $logger->info($info ? 'Checkpoint found' : 'No checkpoint found, starting a new crawl', $info ?? []);
        }
        $crawler->setCheckpoint($checkpoint, $config['resume']);
    }

    addPageProcessors($crawler, $config, $domain);
    installSignalHandlers($crawler, $logger);

    // Notify start (credentials in the config are redacted by the notifier)
    if ($webhooks) {
        $webhooks->notifyCrawlStarted($config['url'], $config);
    }

    // Start crawling
    $logger->info("Starting crawl...");
    $pages = $crawler->crawl($config['url'], $config['maxPages'], $config['maxDepth']);
    $errors = $crawler->getErrors();

    if ($crawler->isInterrupted()) {
        if ($db && $crawlId) {
            $db->completeCrawl($crawlId, ['total_pages' => count($pages), 'errors' => count($errors)], 'interrupted');
        }
        echo PHP_EOL . "Crawl interrupted after " . count($pages) . " pages; no sitemap was written." . PHP_EOL;
        if ($checkpoint) {
            echo "Progress was saved to {$config['checkpointFile']}. Run the same command with --resume to continue."
                . PHP_EOL;
        }
        exit(EXIT_INTERRUPTED);
    }

    // Include patterns and priorities
    $pages = $filter->filterPages($pages);

    $crawlTime = max(microtime(true) - $startTime, 0.001);
    $logger->info("Crawl completed", [
        'duration' => Utils::formatDuration($crawlTime),
        'pages' => count($pages),
        'errors' => count($errors),
        'rate' => round(count($pages) / $crawlTime, 2) . ' pages/sec'
    ]);

    $reportFiles = writeReports($config, $pages, $errors, $logger);

    // Save to database and detect changes
    $changes = null;
    if ($db && $crawlId) {
        $logger->info("Saving to database...");
        $db->saveUrls($crawlId, $pages);

        if ($config['detectChanges']) {
            $previous = $db->getPreviousCrawl($domain, $crawlId);
            if ($previous) {
                $changes = (new ChangeDetector($db))->detectChanges((int)$previous['id'], $crawlId);
                $logger->info("Changes detected", $changes['summary']);

                if ($webhooks) {
                    $webhooks->notifyChangesDetected([
                        'summary' => $changes['summary'],
                        'new' => array_column($changes['new'], 'url'),
                        'modified' => array_column($changes['modified'], 'url'),
                        'deleted' => array_column($changes['deleted'], 'url'),
                    ]);
                }
            } else {
                $logger->info("No previous crawl of {$domain} to compare with; all URLs are new");
            }
        }

        $db->completeCrawl($crawlId, [
            'total_pages' => count($pages),
            'new_pages' => $changes['summary']['new_count'] ?? count($pages),
            'modified_pages' => $changes['summary']['modified_count'] ?? 0,
            'deleted_pages' => $changes['summary']['deleted_count'] ?? 0,
            'errors' => count($errors)
        ]);
    }

    if ($config['onlyChanged'] && $changes !== null) {
        $changed = array_flip(array_merge(
            array_column($changes['new'], 'url'),
            array_column($changes['modified'], 'url')
        ));
        $pages = array_values(array_filter($pages, fn($page) => isset($changed[$page['url']])));

        if (empty($pages)) {
            echo PHP_EOL . "No new or modified URLs since the previous crawl; no sitemap was written." . PHP_EOL;
            exit(0);
        }
        $logger->info("Only changed URLs are written", ['count' => count($pages)]);
    }

    // Additional sitemaps first, so the index can list them
    $extraFiles = [];
    if ($config['imageSitemap']) {
        $extraFiles = array_merge($extraFiles, ImageSitemapWriter::write($pages, $config['out']));
    }
    if ($config['videoSitemap']) {
        $extraFiles = array_merge($extraFiles, VideoSitemapWriter::write($pages, $config['out']));
    }
    if ($config['newsSitemap']) {
        $newsPages = [];
        foreach ($pages as $page) {
            if (isset($page['news'])) {
                $newsPages[] = ['url' => $page['url']] + $page['news'];
            }
        }
        $extraFiles = array_merge($extraFiles, NewsSitemapWriter::write($newsPages, $config['out']));
    }

    // Write sitemaps
    $logger->info("Writing sitemap files...");
    $files = SitemapWriter::write($pages, $config['out'], 50000, $config['publicBase'], $extraFiles);
    $files = array_merge($extraFiles, $files);

    $totalTime = microtime(true) - $startTime;

    // Success summary
    echo "\n" . str_repeat('=', 70) . "\n";
    echo "  ✅ Success!\n";
    echo str_repeat('=', 70) . "\n";
    echo "Generated Files:\n";
    foreach ($files as $file) {
        $size = file_exists($file) ? Utils::formatBytes(filesize($file)) : 'N/A';
        echo "  • " . basename($file) . " ({$size})\n";
    }
    if (!empty($reportFiles)) {
        echo "\nReports:\n";
        foreach ($reportFiles as $file) {
            echo "  • {$file}\n";
        }
    }

    echo "\nStatistics:\n";
    $stats = $crawler->getStats();
    echo "  • Pages in sitemap: " . count($pages) . "\n";
    echo "  • Requests:         {$stats['processed']}\n";
    echo "  • Errors:           {$stats['errors']}\n";
    $skipped = array_filter($stats['skipped']);
    if (!empty($skipped)) {
        $parts = [];
        foreach ($skipped as $reason => $count) {
            $parts[] = str_replace('_', ' ', $reason) . ": {$count}";
        }
        echo "  • Left out:         " . implode(', ', $parts) . "\n";
    }
    echo "  • Total Time:       " . Utils::formatDuration($totalTime) . "\n";
    echo "  • Memory Peak:      " . Utils::getPeakMemoryUsage() . "\n";
    echo "  • Output Dir:       {$config['out']}\n";
    echo str_repeat('=', 70) . "\n";

    // Notify completion
    if ($webhooks && $config['notifyOnComplete']) {
        $webhooks->notifyCrawlCompleted($config['url'], [
            'pages' => count($pages),
            'errors' => count($errors),
            'duration' => $totalTime
        ]);
    }

    exit(0);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, "\n❌ Configuration Error: {$e->getMessage()}\n\n");
    if ($webhooks && ($config['notifyOnError'] ?? false)) {
        $webhooks->notifyCrawlFailed($config['url'] ?? 'unknown', $e->getMessage());
    }
    exit(1);
} catch (\Throwable $e) {
    fwrite(STDERR, "\n❌ Error: {$e->getMessage()}\n");
    if ($config['verbose'] ?? false) {
        fwrite(STDERR, "\nStack Trace:\n" . $e->getTraceAsString() . "\n");
    }
    if ($webhooks && ($config['notifyOnError'] ?? false)) {
        $webhooks->notifyCrawlFailed($config['url'] ?? 'unknown', $e->getMessage());
    }
    fwrite(STDERR, "\n");
    exit(1);
}
